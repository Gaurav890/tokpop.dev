# Public origin used for OAuth metadata and share URLs.
PUBLIC_APP_URL=http://localhost:3000

# Railway Postgres. Railway injects its private DATABASE_URL automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_native_profile
DATABASE_POOL_SIZE=5
# Set to require when using Railway's public Postgres URL from Vercel.
DATABASE_SSL=disable

# Set only on Vercel to send browser API traffic to the Railway service.
# Leave unset on Railway and in local development.
BACKEND_URL=

# Create an OAuth App at https://github.com/settings/developers.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate a long random value; this signs sessions and encrypts stored tokens.
SESSION_SECRET=

# Optional CLI override when pairing against a non-default deployment.
ANP_API_URL=http://localhost:3000
